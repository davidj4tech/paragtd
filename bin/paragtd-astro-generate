#!/usr/bin/env python3
"""Generate Org alerts for lunar and astrological routines."""

from __future__ import annotations

import argparse
import datetime as dt
import os
import sys
from pathlib import Path
from zoneinfo import ZoneInfo

REPO = Path(__file__).resolve().parents[1]
VENV = REPO / ".venv"
VENV_PYTHON = VENV / "bin" / "python"
if VENV_PYTHON.exists() and Path(sys.prefix).resolve() != VENV.resolve():
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), *sys.argv])

try:
    import kerykeion  # noqa: F401
    import swisseph as swe
except ModuleNotFoundError as exc:
    raise SystemExit(
        "Kerykeion/pyswisseph is required. Run: python3 -m venv .venv && .venv/bin/pip install kerykeion"
    ) from exc

SIGNS = [
    "Aries",
    "Taurus",
    "Gemini",
    "Cancer",
    "Leo",
    "Virgo",
    "Libra",
    "Scorpio",
    "Sagittarius",
    "Capricorn",
    "Aquarius",
    "Pisces",
]

UTC = dt.timezone.utc
DEFAULT_TIMEZONE = "Australia/Melbourne"


def julday(moment: dt.datetime) -> float:
    moment = moment.astimezone(UTC)
    hour = moment.hour + moment.minute / 60 + moment.second / 3600
    return swe.julday(moment.year, moment.month, moment.day, hour)


def from_julday(jd: float) -> dt.datetime:
    year, month, day, hour = swe.revjul(jd)
    whole_hour = int(hour)
    minute_float = (hour - whole_hour) * 60
    minute = int(minute_float)
    second = int(round((minute_float - minute) * 60))
    if second == 60:
        second = 0
        minute += 1
    if minute == 60:
        minute = 0
        whole_hour += 1
    return dt.datetime(year, month, day, whole_hour, minute, second, tzinfo=UTC)


def longitude(body: int, moment: dt.datetime) -> float:
    return swe.calc_ut(julday(moment), body)[0][0] % 360


def angle_diff(a: float, b: float) -> float:
    return (a - b + 180) % 360 - 180


def sign_for_lon(lon: float) -> str:
    return SIGNS[int(lon // 30) % 12]


def org_timestamp(moment: dt.datetime, timezone: ZoneInfo) -> str:
    return moment.astimezone(timezone).strftime("<%Y-%m-%d %a %H:%M>")


def bisect_time(start: dt.datetime, end: dt.datetime, predicate, iterations: int = 40) -> dt.datetime:
    low, high = start, end
    initial = predicate(low)
    for _ in range(iterations):
        mid = low + (high - low) / 2
        if predicate(mid) == initial:
            low = mid
        else:
            high = mid
    # Not truncated: the minute floor lands before the crossing, so a sign read
    # there would still be the old one. The Org timestamps drop the seconds.
    return high


def find_threshold_crossings(year: int, value_fn, threshold: float, step: dt.timedelta) -> list[dt.datetime]:
    start = dt.datetime(year, 1, 1, tzinfo=UTC)
    end = dt.datetime(year + 1, 1, 1, tzinfo=UTC)
    events: list[dt.datetime] = []
    t = start
    prev = angle_diff(value_fn(t), threshold)
    while t < end:
        nt = min(t + step, end)
        cur = angle_diff(value_fn(nt), threshold)
        if prev == 0 or cur == 0 or (prev < 0 <= cur) or (prev > 0 >= cur and abs(prev - cur) < 180):
            event = bisect_time(t, nt, lambda m: angle_diff(value_fn(m), threshold) >= 0)
            if event.year == year and (not events or abs((event - events[-1]).total_seconds()) > 86400):
                events.append(event)
        t, prev = nt, cur
    return events


def moon_phase_events(year: int) -> list[tuple[str, str, dt.datetime]]:
    def elongation(moment: dt.datetime) -> float:
        return (longitude(swe.MOON, moment) - longitude(swe.SUN, moment)) % 360

    phases = [
        ("New moon routine", "New", 0),
        ("First quarter moon routine", "First quarter", 90),
        ("Full moon routine", "Full", 180),
        ("Last quarter moon routine", "Last quarter", 270),
    ]
    events: list[tuple[str, str, dt.datetime]] = []
    for title, phase, threshold in phases:
        events += [
            (title, phase, t)
            for t in find_threshold_crossings(year, elongation, threshold, dt.timedelta(hours=6))
        ]
    return sorted(events, key=lambda item: item[2])


def body_ingresses(year: int, body: int, label: str, step: dt.timedelta) -> list[tuple[str, str, dt.datetime]]:
    start = dt.datetime(year, 1, 1, tzinfo=UTC)
    end = dt.datetime(year + 1, 1, 1, tzinfo=UTC)
    events: list[tuple[str, str, dt.datetime]] = []
    t = start
    prev_sign = int(longitude(body, t) // 30)
    while t < end:
        nt = min(t + step, end)
        next_sign = int(longitude(body, nt) // 30)
        if next_sign != prev_sign:
            event = bisect_time(t, nt, lambda m: int(longitude(body, m) // 30) != prev_sign)
            sign = SIGNS[int(longitude(body, event) // 30) % 12]
            if event.year == year:
                events.append((label, sign, event))
        t, prev_sign = nt, next_sign
    return events


def sun_decan_events(year: int) -> list[tuple[str, int, dt.datetime]]:
    start = dt.datetime(year, 1, 1, tzinfo=UTC)
    end = dt.datetime(year + 1, 1, 1, tzinfo=UTC)
    events: list[tuple[str, int, dt.datetime]] = []
    t = start
    prev_bucket = int(longitude(swe.SUN, t) // 10)
    while t < end:
        nt = min(t + dt.timedelta(days=1), end)
        next_bucket = int(longitude(swe.SUN, nt) // 10)
        if next_bucket != prev_bucket:
            event = bisect_time(t, nt, lambda m: int(longitude(swe.SUN, m) // 10) != prev_bucket)
            lon = longitude(swe.SUN, event)
            sign = sign_for_lon(lon)
            decan = int((lon % 30) // 10) + 1
            if event.year == year:
                events.append((sign, decan, event))
        t, prev_bucket = nt, next_bucket
    return events


def heading(lines: list[str], level: int, title: str, moment: dt.datetime, timezone: ZoneInfo, props: dict[str, str], body: list[str]) -> None:
    # A plain active timestamp, not a scheduled TODO: an alert is an event on
    # its day, with nothing to mark done, so it never lingers as overdue.
    lines.append(f"{'*' * level} {title}")
    lines.append(":PROPERTIES:")
    lines.append(f":TIMEZONE: {timezone.key}")
    lines.append(f":UTC: {moment.astimezone(UTC).strftime('%Y-%m-%d %H:%M')}")
    for key, value in props.items():
        lines.append(f":{key}: {value}")
    lines.append(":END:")
    lines.append(org_timestamp(moment, timezone))
    lines.extend(body)
    lines.append("")


def _add_year(output: Path, year: int, header: list[str], body: list[str], append: bool) -> tuple[Path, str]:
    """What OUTPUT should hold with YEAR added: BODY after its current text
    when appending, else after HEADER. Refuses a year it already has."""
    existing = output.read_text(encoding="utf-8") if append and output.exists() else None
    if existing is None:
        return output, "\n".join(header + body)
    if f"* {year} " in existing:
        raise SystemExit(f"{output} already contains {year} alerts; regenerate without --append")
    separator = "" if existing.endswith("\n") else "\n"
    return output, existing + separator + "\n".join(body)


def write_alerts(year: int, output: Path, timezone_name: str, append: bool = False,
                 lunar_output: Path | None = None) -> None:
    """Write YEAR's alerts to OUTPUT. With LUNAR_OUTPUT, the new and full moon
    routines (the ones asking for a check-in) go there instead, so that file
    can sit in the agenda while the rest is looked at on purpose."""
    timezone = ZoneInfo(timezone_name)
    lines: list[str] = []
    lunar: list[str] = []
    lines.append(f"* {year} Lunar Routines")
    if lunar_output is not None:
        lunar.append(f"* {year} Lunar Routines")
    for title, phase, moment in moon_phase_events(year):
        routine = phase in ("New", "Full")
        note = (
            "- Perform the lunar check-in/review."
            if routine
            else "- Quick lunar check-in: course-correct on what the last phase started."
        )
        target = lunar if routine and lunar_output is not None else lines
        heading(target, 2, title, moment, timezone, {"BODY": "Moon", "PHASE": phase}, [note])

    lines.append(f"* {year} Sun Sign Alerts")
    aries_ingress = None
    for _, sign, moment in body_ingresses(year, swe.SUN, "Sun", dt.timedelta(days=1)):
        if sign == "Aries":
            aries_ingress = moment
        heading(lines, 2, f"Sun enters {sign}", moment, timezone, {"BODY": "Sun", "SIGN": sign}, ["- Review the season's emphasis."])

    lines.append(f"* {year} Decan Alerts")
    for sign, decan, moment in sun_decan_events(year):
        heading(lines, 2, f"Sun enters {sign} decan {decan}", moment, timezone, {"BODY": "Sun", "SIGN": sign, "DECAN": str(decan)}, ["- Notice the shift in tone and emphasis."])

    lines.append(f"* {year} Astrological Year")
    if aries_ingress is not None:
        heading(lines, 2, "Astrological new year / Aries ingress", aries_ingress, timezone, {"BODY": "Sun", "SIGN": "Aries"}, ["- Begin annual astrological cycle review."])

    lines.append(f"* {year} Moon Sign Alerts")
    for _, sign, moment in body_ingresses(year, swe.MOON, "Moon", dt.timedelta(hours=3)):
        heading(lines, 2, f"Moon enters {sign}", moment, timezone, {"BODY": "Moon", "SIGN": sign}, ["- Note the emotional/weather shift."])

    # Both checked before either is written, so a refusal leaves both alone.
    writes = [_add_year(output, year, ["#+title: Astro Alerts", "#+filetags: astro lunar routines", ""], lines, append)]
    if lunar_output is not None:
        writes.append(_add_year(lunar_output, year, ["#+title: Lunar Routines", "#+filetags: lunar routines", ""], lunar, append))
    for path, text in writes:
        path.write_text(text, encoding="utf-8")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--year", type=int, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--timezone", default=DEFAULT_TIMEZONE)
    parser.add_argument(
        "--append",
        action="store_true",
        help="Append this year to an existing file instead of replacing it.",
    )
    parser.add_argument(
        "--lunar-output",
        type=Path,
        help="Write the new and full moon routines here instead of --output.",
    )
    args = parser.parse_args()
    args.output.parent.mkdir(parents=True, exist_ok=True)
    if args.lunar_output is not None:
        args.lunar_output.parent.mkdir(parents=True, exist_ok=True)
    write_alerts(args.year, args.output, args.timezone, args.append, args.lunar_output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
